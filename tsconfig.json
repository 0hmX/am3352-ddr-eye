{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@tscircuit/core"
    ],
    "paths": {
      "@tscircuit/fanout-solver": [
        "./node_modules/.cache/tscircuit-declarations/fanout/index.d.ts"
      ],
      "pcb-spice-pipeline/tsx": [
        "./packages/pcb-spice-pipeline/src/tsx.ts"
      ]
    }
  },
  "include": [
    "index.circuit.tsx",
    "simulation.config.ts",
    "examples/**/*.tsx",
    "examples/**/*.ts"
  ]
}
