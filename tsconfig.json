{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@tscircuit/core"
    ]
  },
  "include": [
    "index.circuit.tsx",
    "simulation.config.ts",
    "examples/**/*.tsx",
    "examples/**/*.ts"
  ]
}
