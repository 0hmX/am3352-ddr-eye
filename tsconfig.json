{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@tscircuit/core",
      "node"
    ],
    "paths": {
      "@tscircuit/fanout-solver": [
        "./node_modules/.cache/tscircuit-declarations/fanout/index.d.ts"
      ]
    }
  },
  "include": [
    "index.circuit.tsx",
    "ddr-buffers.ts",
    "examples/**/*.tsx",
    "examples/**/*.ts",
    "tests/**/*.ts"
  ]
}
