{
  "name": "tscircuit-ibis-spice-examples",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build --disable-parts-engine",
    "typecheck": "tsc --noEmit",
    "simulate": "tsci simulate analog index.circuit.tsx",
    "postinstall": "node scripts/prepare-types.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "pnpm simulate:ddr-dq-strip",
    "simulate:non-ddr": "tsci simulate analog examples/differential-data/index.circuit.tsx",
    "simulate:single-ended": "tsci simulate analog examples/single-ended/index.circuit.tsx",
    "simulate:ddr-dq": "tsci simulate analog examples/ddr-dq/index.circuit.tsx",
    "simulate:models": "node scripts/prepare-models.mjs",
    "simulate:ddr-dq-strip": "tsci simulate analog examples/ddr-dq-strip/index.circuit.tsx"
  },
  "dependencies": {
    "tscircuit": "0.0.2940",
    "@tscircuit/core": "https://api.github.com/repos/tscircuit/core/tarball/f788ce72605412158dce363c218367ea07e1595a",
    "@tscircuit/props": "https://api.github.com/repos/tscircuit/props/tarball/045f345751e23909523a85e17ba9cfd94b74ad08",
    "react": "19.2.4",
    "circuit-json": "https://api.github.com/repos/tscircuit/circuit-json/tarball/ac69acd282d521bab7f3156aa3be3069584ba9d7"
  },
  "devDependencies": {
    "@tscircuit/cli": "https://api.github.com/repos/tscircuit/cli/tarball/494c2f8f683aad74fc1e6f8fa9c7642e247c6a09",
    "@tscircuit/eval": "0.0.1538",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "fflate": "0.8.2",
    "tsx": "4.23.15",
    "@tscircuit/pcb-spice-pipeline": "https://api.github.com/repos/tscircuit/pcb-spice-pipeline/tarball/6fa915055b4de27c8430b3a47985af8ea4bf6ed6",
    "@tscircuit/ibis-to-spice": "https://api.github.com/repos/tscircuit/ibis-to-spice/tarball/ad1ec9e640a92a4d370fc76acbbd8db245563317",
    "@types/node": "22.20.5"
  },
  "description": "TSX IBIS and PCB SPICE examples using the programmatic tscircuit pipeline"
}
