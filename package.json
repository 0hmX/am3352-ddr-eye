{
  "name": "tscircuit-ibis-spice-examples",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build --disable-parts-engine",
    "typecheck": "tsc --noEmit",
    "simulate:setup": "pnpm simulate:models && pcb-spice-pipeline --setup",
    "simulate": "pcb-spice-pipeline index.circuit.tsx",
    "simulate:repeat": "pcb-spice-pipeline --repeat index.circuit.tsx",
    "postinstall": "node scripts/prepare-types.mjs",
    "test": "bun test tests",
    "test:native": "pnpm simulate:ddr-dq-strip",
    "simulate:non-ddr": "pcb-spice-pipeline examples/differential-data/index.circuit.tsx",
    "simulate:single-ended": "pcb-spice-pipeline examples/single-ended/index.circuit.tsx",
    "simulate:ddr-dq": "pcb-spice-pipeline examples/ddr-dq/index.circuit.tsx",
    "simulate:compare": "pcb-spice-pipeline --compare",
    "simulate:models": "node scripts/prepare-models.mjs",
    "simulate:ddr-dq-strip": "pcb-spice-pipeline examples/ddr-dq-strip/index.circuit.tsx"
  },
  "dependencies": {
    "tscircuit": "0.0.2940",
    "@tscircuit/core": "file:vendor/tscircuit-core-4e95d06.tgz",
    "@tscircuit/props": "0.0.705",
    "react": "19.2.4",
    "circuit-json": "0.0.531"
  },
  "devDependencies": {
    "@tscircuit/cli": "0.1.2237",
    "@tscircuit/eval": "0.0.1538",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "pcb-spice-pipeline": "github:tscircuit/pcb-spice-pipeline#07cf7f5e4d5ff76affadc11eac5ab3d2db736a0b"
  },
  "description": "Normal tscircuit examples with reusable IBIS conversion and PCB SPICE eye simulation"
}
