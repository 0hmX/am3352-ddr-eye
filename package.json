{
  "name": "tscircuit-ibis-spice-examples",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build --disable-parts-engine",
    "typecheck": "tsc --noEmit",
    "simulate": "tsci simulate analog index.circuit.tsx",
    "postinstall": "node scripts/prepare-types.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "pnpm simulate:ddr-dq-strip",
    "simulate:non-ddr": "tsci simulate analog examples/differential-data/index.circuit.tsx",
    "simulate:single-ended": "tsci simulate analog examples/single-ended/index.circuit.tsx",
    "simulate:ddr-dq": "tsci simulate analog examples/ddr-dq/index.circuit.tsx",
    "simulate:models": "node scripts/prepare-models.mjs",
    "simulate:ddr-dq-strip": "tsci simulate analog examples/ddr-dq-strip/index.circuit.tsx"
  },
  "dependencies": {
    "tscircuit": "0.0.2940",
    "@tscircuit/core": "https://api.github.com/repos/tscircuit/core/tarball/ac28ffa59da8bf3b016bcabfc35e249a2c20fce4",
    "@tscircuit/props": "https://api.github.com/repos/tscircuit/props/tarball/96dae5c65597cdb8535c547568aa5cb510816858",
    "react": "19.2.4",
    "circuit-json": "https://api.github.com/repos/tscircuit/circuit-json/tarball/f9f7c98f687ebea5dd8111548ab60fe7df975eac"
  },
  "devDependencies": {
    "@tscircuit/cli": "https://api.github.com/repos/tscircuit/cli/tarball/d0d965fbe7ffbc29029424a811f5363fe1ce5e85",
    "@tscircuit/eval": "0.0.1538",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "fflate": "0.8.2",
    "tsx": "4.23.15",
    "@tscircuit/pcb-spice-pipeline": "https://api.github.com/repos/tscircuit/pcb-spice-pipeline/tarball/825a6d321a10102393986e91bedf72f9905e204f",
    "@tscircuit/ibis-to-spice": "https://api.github.com/repos/tscircuit/ibis-to-spice/tarball/ad1ec9e640a92a4d370fc76acbbd8db245563317",
    "@types/node": "22.20.5"
  },
  "description": "TSX IBIS and PCB SPICE examples using the programmatic tscircuit pipeline"
}
