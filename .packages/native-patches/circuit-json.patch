index 0000000..b32b0fb
--- /dev/null
+++ b/src/simulation/simulation_signal_integrity.ts
@@ -0,0 +1,148 @@
+import { z } from "zod"
+import { getZodPrefixedIdWithDefault } from "src/common"
+
+const sha256 = z.string().regex(/^[a-f0-9]{64}$/i)
+const archive = z
+  .object({ member: z.string().min(1), memberSha256: sha256.optional() })
+  .strict()
+
+/** source.sha256 covers raw URL/file bytes or UTF-8 content; archive.memberSha256 covers the extracted member. */
+export const simulation_ibis_source = z.union([
+  z
+    .object({ url: z.string().url(), sha256, archive: archive.optional() })
+    .strict(),
+  z
+    .object({
+      file: z.string().min(1),
+      sha256: sha256.optional(),
+      archive: archive.optional(),
+    })
+    .strict(),
+  z.object({ content: z.string().min(1), sha256: sha256.optional() }).strict(),
+])
+export type SimulationIbisSource = z.infer<typeof simulation_ibis_source>
+
+/** Reusable model metadata. Port IDs resolve on the selected chip instance. */
+export const simulation_ibis_model = z.object({
+  type: z.literal("simulation_ibis_model"),
+  simulation_ibis_model_id: getZodPrefixedIdWithDefault(
+    "simulation_ibis_model",
+  ),
+  source_component_id: z.string(),
+  source: simulation_ibis_source,
+  component: z.string().min(1),
+  pin_to_source_port_map: z
+    .record(z.string().min(1), z.string())
+    .refine(
+      (pins) => Object.keys(pins).length > 0,
+      "At least one mapped pin is required",
+    ),
+  model_selections: z.record(z.string(), z.string().min(1)).optional(),
+  references: z
+    .record(
+      z.string(),
+      z
+        .object({
+          pullup: z.string().optional(),
+          pulldown: z.string().optional(),
+          power_clamp: z.string().optional(),
+          ground_clamp: z.string().optional(),
+          external: z.string().optional(),
+        })
+        .strict(),
+    )
+    .optional(),
+  corner: z.enum(["typical", "minimum", "maximum"]),
+  package_policy: z.enum(["vendor", "omit"]),
+})
+export type SimulationIbisModel = z.infer<typeof simulation_ibis_model>
+export type SimulationIbisModelInput = z.input<typeof simulation_ibis_model>
+
+/** One fixed operating state of a physical IBIS port in a named experiment. */
+export const simulation_ibis_pin_state = z
+  .object({
+    type: z.literal("simulation_ibis_pin_state"),
+    simulation_ibis_pin_state_id: getZodPrefixedIdWithDefault(
+      "simulation_ibis_pin_state",
+    ),
+    simulation_experiment_id: z.string(),
+    source_port_id: z.string(),
+    mode: z.enum(["input", "output"]),
+    enabled: z.boolean().optional(),
+  })
+  .superRefine((state, context) => {
+    if (state.mode === "output" && state.enabled === undefined)
+      context.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: ["enabled"],
+        message: "Output state requires explicit enabled intent",
+      })
+    if (state.mode === "input" && state.enabled !== undefined)
+      context.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: ["enabled"],
+        message: "Input state has no output enable control",
+      })
+  })
+export type SimulationIbisPinState = z.infer<typeof simulation_ibis_pin_state>
+export type SimulationIbisPinStateInput = z.input<
+  typeof simulation_ibis_pin_state
+>
+
+/** Explicit binary logic control. All times are normalized milliseconds. */
+export const simulation_digital_stimulus = z.object({
+  type: z.literal("simulation_digital_stimulus"),
+  simulation_digital_stimulus_id: getZodPrefixedIdWithDefault(
+    "simulation_digital_stimulus",
+  ),
+  name: z.string().min(1),
+  simulation_experiment_id: z.string(),
+  source_port_id: z.string(),
+  unit_interval_ms: z.number().finite().positive(),
+  start_time_ms: z.number().finite().nonnegative(),
+  initial_state: z.union([z.literal(0), z.literal(1)]),
+  inverted: z.boolean(),
+  pattern: z
+    .object({
+      type: z.literal("bits"),
+      bits: z.string().regex(/^[01]+$/),
+      repeat: z.boolean(),
+    })
+    .strict(),
+})
+export type SimulationDigitalStimulus = z.infer<
+  typeof simulation_digital_stimulus
+>
+export type SimulationDigitalStimulusInput = z.input<
+  typeof simulation_digital_stimulus
+>
+
+/** Derived measurement; no electrical run settings or inferred receiver phase. */
+export const simulation_eye_diagram = z
+  .object({
+    type: z.literal("simulation_eye_diagram"),
+    simulation_eye_diagram_id: getZodPrefixedIdWithDefault(
+      "simulation_eye_diagram",
+    ),
+    name: z.string().min(1),
+    simulation_experiment_id: z.string(),
+    simulation_voltage_probe_id: z.string(),
+    unit_interval_ms: z.number().finite().positive(),
+    time_origin_ms: z.number().finite(),
+    start_time_ms: z.number().finite().nonnegative().optional(),
+    end_time_ms: z.number().finite().positive().optional(),
+  })
+  .superRefine((eye, context) => {
+    if (
+      eye.start_time_ms !== undefined &&
+      eye.end_time_ms !== undefined &&
+      eye.end_time_ms <= eye.start_time_ms
+    )
+      context.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: ["end_time_ms"],
+        message: "Eye gate end must follow start",
+      })
+  })
+export type SimulationEyeDiagram = z.infer<typeof simulation_eye_diagram>
+export type SimulationEyeDiagramInput = z.input<typeof simulation_eye_diagram>
