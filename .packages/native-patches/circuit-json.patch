--- /dev/null
+++ b/tests/simulation-signal-integrity.test.ts
@@ -0,0 +1,214 @@
+import { expect, test } from "bun:test"
+import {
+  any_circuit_element,
+  type AnyCircuitElementInput,
+} from "../src/any_circuit_element"
+import { simulation_ibis_source } from "../src/simulation/simulation_signal_integrity"
+
+test("signal integrity declarations and waveform identity survive JSON round-trip", () => {
+  const definitions = [
+    {
+      type: "simulation_ibis_model",
+      simulation_ibis_model_id: "model",
+      source_component_id: "chip",
+      source: {
+        url: "https://example.com/vendor.zip",
+        sha256: "a".repeat(64),
+        archive: { member: "vendor.ibs", memberSha256: "b".repeat(64) },
+      },
+      component: "PART",
+      pin_to_source_port_map: { "4": "signal", "5": "vdd" },
+      model_selections: { "4": "BUFFER" },
+      references: { "4": { pullup: "vdd", pulldown: "ground" } },
+      corner: "typical",
+      package_policy: "vendor",
+    },
+    {
+      type: "simulation_ibis_pin_state",
+      simulation_ibis_pin_state_id: "state",
+      simulation_experiment_id: "run",
+      source_port_id: "signal",
+      mode: "output",
+      enabled: true,
+    },
+    {
+      type: "simulation_digital_stimulus",
+      simulation_digital_stimulus_id: "stimulus",
+      name: "data",
+      simulation_experiment_id: "run",
+      source_port_id: "signal",
+      unit_interval_ms: 0.0000025,
+      start_time_ms: 0,
+      initial_state: 0,
+      inverted: false,
+      pattern: { type: "bits", bits: "0011101", repeat: true },
+    },
+    {
+      type: "simulation_eye_diagram",
+      simulation_eye_diagram_id: "eye",
+      name: "RX",
+      simulation_experiment_id: "run",
+      simulation_voltage_probe_id: "probe",
+      unit_interval_ms: 0.0000025,
+      time_origin_ms: 0,
+      start_time_ms: 0.00002,
+      end_time_ms: 0.0001,
+    },
+    {
+      type: "simulation_experiment",
+      simulation_experiment_id: "run",
+      name: "SI",
+      experiment_type: "spice_transient_analysis",
+      execution_mode: "external",
+      execution_status: "pending",
+    },
+    {
+      type: "simulation_transient_voltage_graph",
+      simulation_transient_voltage_graph_id: "graph",
+      simulation_experiment_id: "run",
+      simulation_voltage_probe_id: "probe",
+      voltage_levels: [0, 1],
+      timestamps_ms: [0, 0.0000025],
+      time_per_step: 0.0000025,
+      start_time_ms: 0,
+      end_time_ms: 0.0000025,
+    },
+  ] satisfies AnyCircuitElementInput[]
+  expect(
+    definitions.map((definition) =>
+      any_circuit_element.parse(JSON.parse(JSON.stringify(definition))),
+    ),
+  ).toEqual(definitions)
+})
+
+test("IBIS source serialization keeps raw and member hashes distinct and rejects archive.sha256", () => {
+  const rawHash = "a".repeat(64)
+  const memberHash = "b".repeat(64)
+  const model = {
+    type: "simulation_ibis_model",
+    source_component_id: "chip",
+    component: "PART",
+    pin_to_source_port_map: { "4": "signal" },
+    corner: "typical",
+    package_policy: "omit",
+  }
+  for (const source of [
+    {
+      url: "https://example.com/vendor.zip",
+      sha256: rawHash,
+      archive: { member: "vendor.ibs", memberSha256: memberHash },
+    },
+    {
+      file: "vendor.zip",
+      sha256: rawHash,
+      archive: { member: "vendor.ibs", memberSha256: memberHash },
+    },
+    { file: "vendor.zip", archive: { member: "vendor.ibs" } },
+    { content: "[IBIS Ver] 4.2\n[End]\n", sha256: rawHash },
+  ]) {
+    expect(simulation_ibis_source.parse(source)).toEqual(source)
+    expect(
+      any_circuit_element.parse(
+        JSON.parse(JSON.stringify({ ...model, source })),
+      ),
+    ).toMatchObject({ source })
+  }
+  for (const resource of [
+    { url: "https://example.com/vendor.zip", sha256: rawHash },
+    { file: "vendor.zip", sha256: rawHash },
+  ]) {
+    for (const archive of [
+      { member: "vendor.ibs", sha256: memberHash },
+      { member: "vendor.ibs", memberSha256: memberHash, sha256: rawHash },
+      { member: "vendor.ibs", memberSha256: "invalid" },
+    ]) {
+      const source = { ...resource, archive }
+      expect(simulation_ibis_source.safeParse(source).success).toBe(false)
+      expect(any_circuit_element.safeParse({ ...model, source }).success).toBe(
+        false,
+      )
+    }
+  }
+})
+
+test("invalid source ambiguity, output enable and bit patterns are rejected", () => {
+  expect(() =>
+    simulation_ibis_source.parse({
+      url: "https://example.com/model.ibs",
+      file: "model.ibs",
+      sha256: "a".repeat(64),
+    }),
+  ).toThrow()
+  const base = {
+    type: "simulation_digital_stimulus",
+    name: "data",
+    simulation_experiment_id: "run",
+    source_port_id: "signal",
+    unit_interval_ms: 1,
+    start_time_ms: 0,
+    initial_state: 0,
+    inverted: false,
+  }
+  expect(() =>
+    any_circuit_element.parse({
+      ...base,
+      pattern: { type: "bits", bits: "01x", repeat: true },
+    }),
+  ).toThrow()
+  expect(() =>
+    any_circuit_element.parse({
+      type: "simulation_ibis_pin_state",
+      simulation_experiment_id: "run",
+      source_port_id: "signal",
+      mode: "output",
+    }),
+  ).toThrow()
+  expect(() =>
+    any_circuit_element.parse({
+      type: "simulation_ibis_pin_state",
+      simulation_experiment_id: "run",
+      source_port_id: "signal",
+      mode: "input",
+      enabled: true,
+    }),
+  ).toThrow()
+})
+
+test("native numeric PCB display offsets retain millimeter values", () => {
+  const component = {
+    type: "pcb_component",
+    pcb_component_id: "pcb",
+    source_component_id: "chip",
+    center: { x: -3, y: 3 },
+    layer: "top",
+    rotation: 0,
+    width: 1,
+    height: 1,
+    display_offset_x: -3,
+    display_offset_y: 3,
+  }
+  expect(any_circuit_element.parse(component)).toMatchObject({
+    display_offset_x: -3,
+    display_offset_y: 3,
+  })
+})
+
+test("board silkscreen has no invented component owner", () => {
+  const text = {
+    type: "pcb_silkscreen_text",
+    pcb_silkscreen_text_id: "note",
+    text: "BOARD NOTE",
+    layer: "top",
+    font: "tscircuit2024",
+    font_size: 1,
+    anchor_position: { x: 0, y: 0 },
+    anchor_alignment: "center",
+  }
+  expect(any_circuit_element.parse(text)).not.toHaveProperty("pcb_component_id")
+  expect(
+    any_circuit_element.parse({ ...text, pcb_component_id: "chip" }),
+  ).toHaveProperty("pcb_component_id", "chip")
+  expect(() =>
+    any_circuit_element.parse({ ...text, pcb_component_id: null }),
+  ).toThrow()
+})
