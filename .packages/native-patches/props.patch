--- /dev/null
+++ b/tests/eyediagram.test.ts
@@ -0,0 +1,42 @@
+import { expect, test } from "bun:test"
+import { legacyEyeDiagramProps as eyeDiagramProps } from "../lib/components/eyediagram"
+
+const eye = {
+  name: "DQS",
+  positive: ".U3 > .DQS",
+  negative: ".U3 > .DQSn",
+  unitInterval: "2.5ns",
+  duration: "100ns",
+  timeStep: "10ps",
+  startTime: "20ns",
+} as const
+
+test("eye times normalize strings and raw seconds without modifying input", () => {
+  const input = Object.freeze({ ...eye })
+  const parsed = eyeDiagramProps.parse(input)
+  expect(parsed.unitInterval).toBeCloseTo(2.5e-9, 18)
+  expect(parsed.duration).toBeCloseTo(1e-7, 18)
+  expect(parsed.timeStep).toBeCloseTo(1e-11, 18)
+  expect(parsed.startTime).toBeCloseTo(2e-8, 18)
+  expect(input).toEqual(eye)
+  expect(eyeDiagramProps.parse({ ...eye, duration: 1e-7 }).duration).toBe(1e-7)
+  expect(
+    eyeDiagramProps.parse({ ...eye, startTime: undefined }).startTime,
+  ).toBe(0)
+})
+
+test("eye props reject missing units, invalid timing and degenerate measurements", () => {
+  for (const changes of [
+    { unitInterval: "2.5" },
+    { unitInterval: 0 },
+    { duration: Infinity },
+    { timeStep: "2ns" },
+    { startTime: "98ns" },
+    { startTime: -1 },
+    { negative: eye.positive },
+    { name: " " },
+  ])
+    expect(eyeDiagramProps.safeParse({ ...eye, ...changes }).success).toBe(
+      false,
+    )
+})
diff --git a/tests/general-simulation.test.tsx b/tests/general-simulation.test.tsx
new file mode 100644
index 0000000..a7af36d
--- /dev/null
+++ b/tests/general-simulation.test.tsx
@@ -0,0 +1,192 @@
+import { expect, test } from "bun:test"
+import {
+  analogDigitalStimulusProps,
+  analogEyeDiagramProps,
+  analogTransientSimulationProps,
+  chipProps,
+  eyeDiagramProps,
+  ibisSource,
+  ibisModelDefinitionProps,
+  ibismodelProps,
+  type AnalogEyeDiagramProps,
+  type ChipProps,
+  type IbisModelDefinition,
+} from "lib"
+import { createElement } from "react"
+
+const model: IbisModelDefinition = {
+  source: { content: "[IBIS Ver] 4.2\n[End]\n" },
+  component: "Buffer",
+  pinMap: { "1": "OUT", "2": "VDD", "3": "GND" },
+  modelSelections: { "1": "TX" },
+  references: { "1": { pullup: "VDD", pulldown: "GND" } },
+  corner: "typical",
+  packagePolicy: "omit",
+}
+
+test("general times use upstream milliseconds, preserve raw input, and reject legacy conflicts", () => {
+  const eye: AnalogEyeDiagramProps = Object.freeze({
+    name: "RX_eye",
+    probeRef: ".RX",
+    simulationRef: ".SI",
+    unitInterval: "2.5ns",
+    timeOrigin: "1ns",
+    startTime: "20ns",
+    endTime: "100ns",
+  })
+  const parsed = analogEyeDiagramProps.parse(eye)
+  expect(parsed.unitInterval).toBeCloseTo(2.5e-6, 18)
+  expect(parsed.timeOrigin).toBeCloseTo(1e-6, 18)
+  expect(parsed.startTime).toBeCloseTo(20e-6, 18)
+  expect(parsed.endTime).toBeCloseTo(100e-6, 18)
+  expect(eye.unitInterval).toBe("2.5ns")
+  expect(
+    analogEyeDiagramProps.parse({ ...eye, unitInterval: 0.25 }).unitInterval,
+  ).toBe(0.25)
+  for (const changes of [
+    { timeOrigin: undefined },
+    { unitInterval: 0 },
+    { unitInterval: Infinity },
+    { endTime: "10ns" },
+    { duration: "100ns" },
+    { positive: ".U1 > .OUT" },
+  ])
+    expect(eyeDiagramProps.safeParse({ ...eye, ...changes }).success).toBe(
+      false,
+    )
+})
+
+test("general IBIS electrical sources and JSX shorthand contain no run controls", () => {
+  expect(ibisModelDefinitionProps.parse(model)).toEqual(model)
+  expect(
+    ibismodelProps.parse({ ...model, componentRef: ".bank > .U1" })
+      .componentRef,
+  ).toBe(".bank > .U1")
+  const jsx: ChipProps = {
+    name: "U1",
+    ibisModel: createElement("ibismodel", model),
+  }
+  expect(chipProps.parse(jsx).ibisModel).toEqual(jsx.ibisModel)
+  expect(chipProps.parse({ name: "U1", ibisModel: model }).ibisModel).toEqual(
+    model,
+  )
+  expect(
+    ibisModelDefinitionProps.safeParse({ ...model, stimulus: {} }).success,
+  ).toBe(false)
+  expect(
+    ibisModelDefinitionProps.safeParse({
+      ...model,
+      source: {
+        content: "data",
+        url: "https://example.test/model.ibs",
+        sha256: "a".repeat(64),
+      },
+    }).success,
+  ).toBe(false)
+  expect(
+    ibisModelDefinitionProps.safeParse({
+      ...model,
+      source: { url: "https://example.test/model.ibs" },
+    }).success,
+  ).toBe(false)
+  expect(
+    ibisModelDefinitionProps.parse({
+      ...model,
+      source: {
+        file: "models/vendor.zip",
+        archive: { member: "buffer.ibs", memberSha256: "a".repeat(64) },
+      },
+    }).source,
+  ).toEqual({
+    file: "models/vendor.zip",
+    archive: { member: "buffer.ibs", memberSha256: "a".repeat(64) },
+  })
+})
+
+test("raw source and extracted member checksums remain distinct and the old archive key is rejected", () => {
+  const rawHash = "a".repeat(64)
+  const memberHash = "b".repeat(64)
+  for (const source of [
+    {
+      url: "https://example.test/vendor.zip",
+      sha256: rawHash,
+      archive: { member: "buffer.ibs", memberSha256: memberHash },
+    },
+    {
+      file: "vendor.zip",
+      sha256: rawHash,
+      archive: { member: "buffer.ibs", memberSha256: memberHash },
+    },
+    { file: "vendor.zip", archive: { member: "buffer.ibs" } },
+    { content: "[IBIS Ver] 4.2\n[End]\n", sha256: rawHash },
+  ]) {
+    expect(ibisSource.parse(source)).toEqual(source)
+    expect(ibisModelDefinitionProps.parse({ ...model, source }).source).toEqual(
+      source,
+    )
+  }
+  for (const resource of [
+    { url: "https://example.test/vendor.zip", sha256: rawHash },
+    { file: "vendor.zip", sha256: rawHash },
+  ]) {
+    for (const archive of [
+      { member: "buffer.ibs", sha256: memberHash },
+      { member: "buffer.ibs", memberSha256: memberHash, sha256: rawHash },
+      { member: "buffer.ibs", memberSha256: "invalid" },
+    ]) {
+      expect(ibisSource.safeParse({ ...resource, archive }).success).toBe(false)
+      expect(
+        ibismodelProps.safeParse({ ...model, source: { ...resource, archive } })
+          .success,
+      ).toBe(false)
+    }
+  }
+})
+
+test("digital controls validate binary sequences and fixed pin-state discriminants", () => {
+  const stimulus = {
+    name: "TX",
+    simulationRef: ".SI",
+    drives: ".U1 > .OUT",
+    unitInterval: "2.5ns",
+    startTime: "0ns",
+    initialState: 0,
+    inverted: true,
+    pattern: { type: "bits", bits: "001101", repeat: true },
+  }
+  const before = JSON.stringify(stimulus)
+  const parsed = analogDigitalStimulusProps.parse(stimulus)
+  expect(parsed.unitInterval).toBeCloseTo(2.5e-6, 18)
+  expect(parsed.pattern.bits).toBe("001101")
+  expect(parsed.initialState).toBe(0)
+  expect(parsed.inverted).toBe(true)
+  expect(JSON.stringify(stimulus)).toBe(before)
+  for (const bits of ["", "012", "01 "])
+    expect(
+      analogDigitalStimulusProps.safeParse({
+        ...stimulus,
+        pattern: { ...stimulus.pattern, bits },
+      }).success,
+    ).toBe(false)
+  expect(
+    analogTransientSimulationProps.parse({
+      ibisPinStates: {
+        ".U1 > .OUT": { mode: "output", enabled: true },
+        ".U2 > .IN": { mode: "input" },
+      },
+    }).ibisPinStates,
+  ).toEqual({
+    ".U1 > .OUT": { mode: "output", enabled: true },
+    ".U2 > .IN": { mode: "input" },
+  })
+  for (const state of [
+    { mode: "output" },
+    { mode: "input", enabled: true },
+    { mode: "dynamic" },
+  ])
+    expect(
+      analogTransientSimulationProps.safeParse({
+        ibisPinStates: { ".U1 > .OUT": state },
+      }).success,
+    ).toBe(false)
+})
