{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "lib",
    "outDir": "types",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "esModuleInterop": true
  },
  "include": [
    "lib/**/*.ts"
  ]
}
