{
  "name": "pcb-spice-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tsx": {
      "types": "./dist/tsx.d.ts",
      "import": "./dist/tsx.js"
    }
  },
  "files": [
    "dist",
    "scripts/audit-eye.mjs",
    "toolchain-lock.json"
  ],
  "bin": {
    "pcb-spice-pipeline": "dist/cli.mjs"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:native": "node --import tsx --test tests/general.integration.mjs",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "react": "19.2.4",
    "tsx": "4.23.15",
    "circuit-json": "https://pkg.pr.new/circuit-json@33a8207",
    "tar": "7.5.22",
    "zod": "3.25.76",
    "earcut": "3.2.4",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@tscircuit/core": "https://pkg.pr.new/tscircuit/core/@tscircuit/core@5f03a21",
    "@tscircuit/ibis-to-spice": "workspace:*",
    "@tscircuit/props": "https://pkg.pr.new/@tscircuit/props@c390bfa",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@tscircuit/core": ">=0.0.2171",
    "@tscircuit/props": ">=0.0.704",
    "@tscircuit/ibis-to-spice": "0.0.2"
  }
}
